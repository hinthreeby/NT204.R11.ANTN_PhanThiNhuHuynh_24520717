# T01: a bad SID between two valid rules.

alert tcp any any -> any 443 (msg:"T01 first additional rule"; sid:100004; rev:1;)
alert tcp any any -> any 80 (msg:"T01 invalid SID"; sid:not_an_integer; rev:1;)

alert udp any any <> any 5353 (msg:"T01 last additional rule"; sid:100005; rev:1;)
# End of secondary input.
