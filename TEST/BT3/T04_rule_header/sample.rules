# T04: header field values and invalid header controls.
alert tcp 192.0.2.10 50000 -> 198.51.100.20 80 (msg:"T04 TCP exact IPv4"; sid:400001; rev:1;)
alert tcp any any -> 198.51.100.20 443 (msg:"T04 TCP any source"; sid:400002; rev:2;)
alert tcp 192.0.2.10 12345 -> any any (msg:"T04 TCP any destination"; sid:400003; rev:3;)
alert tcp 192.0.2.129/24 1000:2000 -> 198.51.100.25 25 (msg:"T04 TCP source CIDR"; sid:400004; rev:1;)
alert tcp 192.0.2.10 443 <> 198.51.100.129/24 1024:65535 (msg:"T04 TCP destination CIDR"; sid:400005; rev:2;)
alert tcp 0.0.0.0/0 0:65535 <> 203.0.113.7/32 80:80 (msg:"T04 TCP CIDR and range boundaries"; sid:400006; rev:3;)
alert tcp any 0 -> any 65535 (msg:"T04 TCP single port boundaries"; sid:400007; rev:1;)
alert udp 192.0.2.53 53 <> 198.51.100.0/24 50000:60000 (msg:"T04 UDP regression"; sid:400008; rev:4;)
alert tcp 999.0.0.1 any -> any 80 (msg:"T04 invalid IPv4"; sid:400009; rev:1;)
alert tcp any any -> 198.51.100.0/33 80 (msg:"T04 invalid CIDR"; sid:400010; rev:1;)
alert tcp any 65536 -> any 80 (msg:"T04 invalid port"; sid:400011; rev:1;)
alert tcp any 2000:1000 -> any 80 (msg:"T04 reversed range"; sid:400012; rev:1;)
alert tcp any any => any 80 (msg:"T04 invalid direction"; sid:400013; rev:1;)
