# T12: supported TCP flags and transport payload sizes.
alert tcp any any -> any any (msg:"SYN packet"; flags:S; sid:101201; rev:1;)
alert tcp any any -> any any (msg:"Empty payload"; dsize:0; sid:101202; rev:1;)
alert tcp any any -> any any (msg:"Payload greater than ten"; dsize:>10; sid:101203; rev:1;)
alert tcp any any -> any any (msg:"ACK with payload"; flags:A; dsize:>10; sid:101204; rev:1;)
alert tcp any any -> any any (msg:"SYN ACK packet"; flags:SA; sid:101205; rev:1;)
alert tcp any any -> any any (msg:"ACK packet"; flags:A; sid:101206; rev:1;)
alert tcp any any -> any any (msg:"Payload less than ten"; dsize:<10; sid:101207; rev:1;)
alert tcp any any -> any any (msg:"Ten payload bytes"; dsize:10; sid:101208; rev:1;)
alert tcp any any -> any any (msg:"Open payload range"; dsize:10<>20; sid:101209; rev:1;)
alert tcp any any -> any any (msg:"No TCP flags"; flags:0; sid:101210; rev:1;)
alert tcp any any -> any any (msg:"FIN packet"; flags:F; sid:101211; rev:1;)
alert tcp any any -> any any (msg:"RST packet"; flags:R; sid:101212; rev:1;)
alert tcp any any -> any any (msg:"PSH packet"; flags:P; sid:101213; rev:1;)
alert tcp any any -> any any (msg:"URG packet"; flags:U; sid:101214; rev:1;)
alert tcp any any -> any any (msg:"CWR packet"; flags:C; sid:101215; rev:1;)
alert tcp any any -> any any (msg:"ECE packet"; flags:E; sid:101216; rev:1;)
alert udp any any -> any any (msg:"Three UDP payload bytes"; dsize:3; sid:101217; rev:1;)
