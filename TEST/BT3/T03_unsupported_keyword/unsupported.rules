# T03: unsupported keywords, quoted text and invalid syntax controls.
alert tcp any any -> any 80 (msg:"T03 valid before unsupported rules"; content:"safe"; nocase; sid:300002; rev:1;)
alert tcp any any -> any 80 (msg:"T03 PCRE"; pcre:"/a;b/i"; sid:300003; rev:1;)
alert tcp any any -> any 80 (msg:"T03 byte test"; byte_test:1,=,65,0; sid:300004; rev:1;)
alert tcp any any -> any 80 (msg:"T03 byte jump"; byte_jump:1,0; sid:300005; rev:1;)
alert tcp any any -> any 80 (msg:"T03 unknown keyword"; future_keyword:1; sid:300006; rev:1;)
alert tcp any any -> any 80 (msg:"T03 mixed keywords"; content:"abc"; nocase; pcre:"/abc/"; byte_test:1,=,65,0; byte_jump:1,0; future_keyword:1; sid:300007; rev:1;)
alert tcp any any -> any 80 (msg:"T03 quoted keyword text"; content:"pcre:\"literal\"; byte_test; byte_jump; future_keyword"; nocase; sid:300008; rev:1;)
alert tcp any any -> any 80 (msg:"T03 unsupported before bad SID"; pcre:"/abc/"; sid:bad; rev:1;)
alert tcp any any -> any 80 (msg:"T03 bad SID before unsupported"; sid:bad; pcre:"/abc/"; rev:1;)
alert tcp any any -> any 80 (msg:"T03 unclosed PCRE string"; pcre:"/unfinished; sid:300011; rev:1;)
alert tcp any any -> any 80 (msg:"T03 missing revision"; pcre:"/abc/"; sid:300012;)
alert tcp any any -> any 80 (msg:"T03 supported keywords"; content:"GET"; nocase; offset:0; depth:100; content:"HTTP"; distance:0; within:100; flags:PA; dsize:>0; flow:to_server,established; classtype:web-application-attack; priority:1; sid:300013; rev:1;)
alert udp any any -> any 53 (msg:"T03 valid after unsupported rules"; content:"end"; nocase; sid:300014; rev:1;)
